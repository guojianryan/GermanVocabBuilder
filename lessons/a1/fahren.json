  "keyTrap": {
    "title": "The big trap: gehen or fahren?",
    "explanation": "Gehen is on foot. If you're travelling to another city, you almost certainly fahren (or fliegen).",
    "wrong": {
      "german": "Morgen gehe ich nach München.",
      "verdict": "This sounds like you're walking to Munich."
    },
    "correct": [
      {
        "german": "Morgen fahre ich nach München.",
        "literal": "Tomorrow I travel to Munich.",
        "note": "By train or car: fahren."
      },
      {
        "german": "Ich gehe zum Bäcker.",
        "literal": "I walk to the baker's.",
        "note": "On foot: gehen."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "mit + vehicle",
      "explanation": "How you travel takes mit + dative.",
      "wrong": "Ich fahre bei Bus.",
      "correct": "Ich fahre mit dem Bus."
    },
    {
      "title": "sein in the past",
      "explanation": "Fahren is movement, so it uses sein.",
      "wrong": "Ich habe nach Hamburg gefahren.",
      "correct": "Ich bin nach Hamburg gefahren."
    }
  ],
