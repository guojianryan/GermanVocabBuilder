  "keyTrap": {
    "title": "The big trap: dein or Ihr?",
    "explanation": "Use dein only with people you call du. For Sie, it's Ihr with a capital I.",
    "wrong": {
      "german": "Herr Müller, ist das dein Koffer?",
      "verdict": "You say Sie to Herr Müller, so: Ihr."
    },
    "correct": [
      {
        "german": "Herr Müller, ist das Ihr Koffer?",
        "literal": "Mr Müller, is that your suitcase?",
        "note": "Formal: Ihr."
      },
      {
        "german": "Tom, ist das dein Koffer?",
        "literal": "Tom, is that your suitcase?",
        "note": "Informal: dein."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Endings",
      "explanation": "Dein needs the right ending, just like ein.",
      "wrong": "Ich mag dein Hund.",
      "correct": "Ich mag deinen Hund."
    }
  ],
