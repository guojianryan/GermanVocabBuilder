    "headword": "von",
    "partOfSpeech": "preposition (always with the dative)",
    "pronunciation": {
      "respelling": "FON",
      "ipa": "fɔn",
      "notes": "V = f. Short o."
    },
    "meaning": "from; of; by",
    "shortDefinition": "Starting point, belonging, or who did something."
  },
  "intro": {
    "title": "Von hier bis da",
    "paragraphs": [
      "Von = from (von Montag bis Freitag, ein Brief von Anna), 'of' instead of the genitive (die Mutter von Tom), and 'by' (ein Buch von Goethe). Always dative; von dem → vom."
    ]
  },
  "wordFamily": [
    {
      "german": "vom",
      "english": "from the (von dem)",
      "type": "contraction"
    },
    {
      "german": "aus",
      "english": "from (origin)",
      "type": "preposition"
    },
    {
      "german": "von … bis",
      "english": "from … to",
      "type": "phrase"
    }
  ],
  "keyTrap": {
    "title": "The big trap: von or aus?",
    "explanation": "Your home country or city: aus. Coming back from a place or person: von.",
    "wrong": {
      "german": "Ich komme von Brasilien.",
      "verdict": "Origin: aus."
    },
    "correct": [
      {
        "german": "Ich komme aus Brasilien.",
        "literal": "I come out of Brazil.",
        "note": "Origin: aus."
      },
      {
        "german": "Ich komme gerade vom Supermarkt.",
        "literal": "I come just from-the supermarket.",
        "note": "Coming back: von."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Of (possession)",
      "explanation": "Von + dative replaces the genitive in speech.",
      "examples": [
        {
          "german": "das Auto von meinem Bruder",
          "english": "my brother's car",
          "highlight": "von"
        }
      ]
    },
    {
      "title": "vom",
      "explanation": "Von dem usually shortens.",
      "wrong": "von dem Bahnhof",
      "correct": "vom Bahnhof"
    }
  ],
  "sampleSentences": [
