  "intro": {
    "title": "Über alles",
    "paragraphs": [
      "Über means 'over, above' (das Bild hängt über dem Sofa), 'across' (über die Straße), 'via' (über Frankfurt), and 'about' a topic (über Politik sprechen)."
    ]
  },
