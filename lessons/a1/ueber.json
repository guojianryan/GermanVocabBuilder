  "keyTrap": {
    "title": "The big trap: talking about something",
    "explanation": "Talking or writing ABOUT something uses über + accusative, not von.",
    "wrong": {
      "german": "Wir sprechen von dem Film. (about the film)",
      "verdict": "Topic: über."
    },
    "correct": [
      {
        "german": "Wir sprechen über den Film.",
        "literal": "We speak over the film.",
        "note": "Topic: über + accusative."
      },
