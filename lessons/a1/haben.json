  "keyTrap": {
    "title": "The big trap: 'I am hungry'",
    "explanation": "Hunger, thirst, fear, time and birthdays are things you 'have' in German.",
    "wrong": {
      "german": "Ich bin Hunger.",
      "verdict": "You have hunger: Ich habe Hunger."
    },
    "correct": [
      {
        "german": "Ich habe Hunger.",
        "literal": "I have hunger.",
        "note": "Hungry."
      },
      {
        "german": "Hast du morgen Zeit?",
        "literal": "Have you tomorrow time?",
        "note": "Are you free tomorrow?"
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "haben or sein in the past?",
      "explanation": "Most verbs use haben. Movement and change verbs use sein.",
      "examples": [
        {
          "german": "Ich habe gegessen.",
          "english": "I ate.",
          "highlight": "habe"
        },
        {
          "german": "Ich bin gefahren.",
          "english": "I drove.",
          "highlight": "bin"
        }
      ]
    },
    {
      "title": "du hast, er hat",
      "explanation": "No b in these two forms.",
      "wrong": "Er habt ein Auto.",
      "correct": "Er hat ein Auto."
