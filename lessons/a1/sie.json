  "keyTrap": {
    "title": "The big trap: die-nouns are sie",
    "explanation": "Any feminine noun becomes sie, even a thing.",
    "wrong": {
      "german": "Die Lampe? Es ist kaputt.",
      "verdict": "Die Lampe → sie."
    },
    "correct": [
      {
        "german": "Die Lampe? Sie ist kaputt.",
        "literal": "The lamp? She is broken.",
        "note": "Die-noun: sie."
      },
      {
        "german": "Die Kinder? Sie sind im Garten.",
        "literal": "The children? They are in the garden.",
        "note": "Plural: sie sind."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Dative",
      "explanation": "To her: ihr. To them: ihnen.",
      "examples": [
        {
          "german": "Ich helfe ihr.",
          "english": "I'm helping her.",
          "highlight": "ihr."
        }
      ]
    }
  ],
  "sampleSentences": [
