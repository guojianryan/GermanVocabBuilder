  "keyTrap": {
    "title": "The big trap: noch nicht vs nicht mehr",
    "explanation": "Noch nicht = not yet (it will happen). Nicht mehr = no longer (it's over).",
    "wrong": {
      "german": "Er ist nicht mehr da. (meaning: hasn't arrived yet)",
      "verdict": "That means he's gone."
    },
