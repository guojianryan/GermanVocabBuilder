        "german": "Er ist noch nicht da.",
        "literal": "He is still not there.",
        "note": "Not yet."
      },
      {
        "german": "Er ist nicht mehr da.",
        "literal": "He is not more there.",
        "note": "No longer."
      }
    ]
  },
  "commonMistakes": [
