      "english": "not yet",
      "type": "phrase"
    },
    {
      "german": "nicht mehr",
      "english": "no longer",
      "type": "phrase"
    }
  ],
  "keyTrap": {
    "title": "The big trap: where nicht goes",
    "explanation": "Nicht usually goes at the end of the sentence, but before adjectives, places and the second verb.",
    "wrong": {
      "german": "Ich nicht komme morgen.",
      "verdict": "Nicht doesn't go before the conjugated verb."
    },
    "correct": [
      {
        "german": "Ich komme morgen nicht.",
        "literal": "I come tomorrow not.",
        "note": "Negating the whole sentence: end."
      },
      {
        "german": "Das ist nicht teuer.",
        "literal": "That is not expensive.",
        "note": "Before an adjective."
      },
      {
        "german": "Ich kann nicht kommen.",
        "literal": "I can not come.",
        "note": "Before the second verb."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "kein for nouns",
      "explanation": "Nouns with ein or no article take kein.",
      "wrong": "Ich habe nicht Auto.",
      "correct": "Ich habe kein Auto."
    }
  ],
