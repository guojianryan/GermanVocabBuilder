    "headword": "nach",
    "partOfSpeech": "preposition (always with the dative)",
    "pronunciation": {
      "respelling": "NAHKH",
      "ipa": "naːx",
      "notes": "Long a, throaty ch."
    },
    "meaning": "to (cities, countries); after; past (time)",
    "shortDefinition": "Direction to places without an article, and 'after' in time."
  },
  "intro": {
    "title": "Nach Berlin, nach dem Essen",
    "paragraphs": [
      "Nach is 'to' for cities and most countries (nach Berlin, nach Spanien), and for going home (nach Hause). It also means 'after': nach dem Essen, and in clock times: zehn nach drei (3:10)."
    ]
  },
