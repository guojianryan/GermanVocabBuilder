      "english": "to (countries with an article)",
      "type": "preposition"
    },
    {
      "german": "danach",
      "english": "afterwards",
      "type": "adverb"
    }
  ],
  "keyTrap": {
    "title": "The big trap: nach, zu or in?",
    "explanation": "Nach: cities, countries without an article, home. Zu: people, shops, buildings. In: countries with an article, and inside places.",
    "wrong": {
      "german": "Ich gehe nach dem Supermarkt.",
      "verdict": "This means 'after the supermarket'. Going to a shop: zu."
    },
    "correct": [
      {
        "german": "Ich gehe zum Supermarkt.",
        "literal": "I go to-the supermarket.",
        "note": "Shops, people: zu."
      },
      {
        "german": "Ich fliege nach Kanada.",
        "literal": "I fly to Canada.",
        "note": "Countries, cities: nach."
      },
      {
        "german": "Ich fahre in die Schweiz.",
        "literal": "I drive into the Switzerland.",
        "note": "Countries with die: in."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Telling the time",
      "explanation": "Nach = past.",
      "examples": [
        {
          "german": "Es ist zehn nach acht.",
          "english": "It's ten past eight.",
          "highlight": "nach"
        }
      ]
    },
    {
      "title": "After + dative",
      "explanation": "Nach always takes the dative.",
      "wrong": "nach den Kurs",
      "correct": "nach dem Kurs"
    }
  ],
