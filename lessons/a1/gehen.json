  "keyTrap": {
    "title": "The big trap: gehen is on foot",
    "explanation": "For trips by car, train or plane, use fahren or fliegen. Gehen is walking, or going somewhere nearby.",
    "wrong": {
      "german": "Ich gehe mit dem Auto zur Arbeit.",
      "verdict": "With a car it's fahren."
    },
    "correct": [
      {
        "german": "Ich fahre mit dem Auto zur Arbeit.",
        "literal": "I drive with the car to work.",
        "note": "Vehicle: fahren."
      },
      {
        "german": "Ich gehe zu Fuß zur Arbeit.",
        "literal": "I go on foot to work.",
        "note": "Walking: gehen."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Past with sein",
      "explanation": "Gehen is movement, so it uses sein.",
      "wrong": "Ich habe nach Hause gegangen.",
      "correct": "Ich bin nach Hause gegangen."
    },
    {
      "title": "Going to do something",
      "explanation": "Gehen + infinitive, with no zu.",
      "examples": [
