  "keyTrap": {
    "title": "The big trap: the ending must match",
    "explanation": "Dies- always needs the ending of der, die or das for that noun.",
    "wrong": {
      "german": "Ich möchte dies Jacke.",
      "verdict": "Die Jacke → diese Jacke."
    },
    "correct": [
      {
        "german": "Ich möchte diese Jacke.",
        "literal": "I'd like this jacket.",
        "note": "Die → diese."
      },
      {
        "german": "Ich nehme diesen Pullover.",
        "literal": "I'll take this jumper.",
        "note": "Den → diesen."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "This week, this year",
      "explanation": "Time phrases use the accusative without a preposition.",
      "examples": [
        {
          "german": "Diese Woche habe ich frei.",
          "english": "I'm off this week.",
          "highlight": "Diese"
        },
        {
          "german": "Diesen Sommer fahren wir nach Spanien.",
          "english": "This summer we're going to Spain.",
          "highlight": "Diesen"
        }
      ]
    }
