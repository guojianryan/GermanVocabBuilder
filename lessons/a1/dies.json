    "pronunciation": {
      "respelling": "DEEZ-er, DEEZ-uh, DEEZ-es",
      "ipa": "ˈdiːzɐ, ˈdiːzə, ˈdiːzəs",
      "notes": "Long ie, the s sounds like z."
    },
    "meaning": "this, these",
    "shortDefinition": "Points at a specific thing near you."
  },
  "intro": {
    "title": "This one",
    "paragraphs": [
      "Dies- means 'this'. Its endings copy der, die, das: der → dieser, die → diese, das → dieses, den → diesen. If you know the article, you know the ending."
    ]
  },
