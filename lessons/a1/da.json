  "keyTrap": {
    "title": "The big trap: da with sein",
    "explanation": "'Is X in?' and 'X isn't here' use da sein, not a word for 'in' or 'here'.",
    "wrong": {
      "german": "Ist Herr Weber in?",
      "verdict": "Asking if someone is present: da."
    },
    "correct": [
      {
        "german": "Ist Herr Weber da?",
        "literal": "Is Mr Weber there?",
        "note": "Present, in the office: da sein."
      },
      {
        "german": "Wir sind im Moment nicht da.",
        "literal": "We are at the moment not there.",
        "note": "On an answering machine."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Word order",
      "explanation": "When da starts a sentence, the verb comes next.",
      "wrong": "Da der Bus kommt.",
      "correct": "Da kommt der Bus."
    },
    {
      "title": "da or dort?",
      "explanation": "Dort is further away and more precise; da is everyday and vague.",
      "examples": [
        {
          "german": "Da drüben!",
          "english": "Over there!",
          "highlight": "Da"
        }
      ]
    }
  ],
