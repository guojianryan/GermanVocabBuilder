  "keyTrap": {
    "title": "The big trap: zu or nach?",
    "explanation": "Zu: people, shops, buildings, events. Nach: cities, countries, home.",
    "wrong": {
      "german": "Ich fahre zu Berlin.",
      "verdict": "Cities: nach."
    },
    "correct": [
      {
        "german": "Ich fahre nach Berlin.",
        "literal": "I travel to Berlin.",
        "note": "City: nach."
      },
      {
        "german": "Ich gehe zum Bäcker.",
        "literal": "I go to-the baker.",
        "note": "Shop/person: zu."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "too",
      "explanation": "Zu + adjective = too.",
      "examples": [
        {
          "german": "Das ist zu teuer.",
          "english": "That's too expensive.",
          "highlight": "zu"
