  "keyTrap": {
    "title": "The big trap: ich will sounds rude",
    "explanation": "Ordering with ich will sounds demanding. Use möchte.",
    "wrong": {
      "german": "Ich will einen Tee.",
      "verdict": "Grammatical, but sounds pushy in a café."
    },
    "correct": [
      {
        "german": "Ich möchte einen Tee, bitte.",
        "literal": "I'd like a tea, please.",
        "note": "Polite."
      },
      {
        "german": "Ich hätte gern einen Tee.",
        "literal": "I would have gladly a tea.",
        "note": "Also polite."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "er möchte",
      "explanation": "No -t for er/sie/es.",
      "wrong": "Sie möchtet Wasser.",
      "correct": "Sie möchte Wasser."
