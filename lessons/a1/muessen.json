  "keyTrap": {
    "title": "The big trap: nicht müssen ≠ mustn't",
    "explanation": "Du musst nicht kommen = you don't have to come. 'You mustn't' is du darfst nicht.",
    "wrong": {
      "german": "Du musst hier nicht rauchen. (meaning: forbidden)",
      "verdict": "This means smoking is optional."
    },
    "correct": [
      {
        "german": "Du darfst hier nicht rauchen.",
        "literal": "You may not smoke here.",
        "note": "Forbidden."
      },
      {
        "german": "Du musst nicht kommen.",
        "literal": "You must not come.",
        "note": "= You don't have to come."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Main verb at the end",
      "explanation": "The infinitive goes to the very end.",
      "wrong": "Ich muss gehen jetzt.",
      "correct": "Ich muss jetzt gehen."
    }
