  "keyTrap": {
    "title": "The big trap: alle or alles?",
    "explanation": "Alle points at a group of people or things. Alles means 'everything' and takes a singular verb.",
    "wrong": {
      "german": "Alle ist gut.",
      "verdict": "'Everything is good' needs alles."
    },
    "correct": [
      {
        "german": "Alles ist gut.",
        "literal": "Everything is good.",
        "note": "Everything: alles, singular verb."
      },
      {
        "german": "Alle sind gut.",
        "literal": "All are good.",
        "note": "Everyone or all of them: alle, plural verb."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Every day",
      "explanation": "For 'every' with a singular noun, use jeder. Alle needs a plural.",
      "wrong": "alle Tag",
      "correct": "jeden Tag / alle Tage"
    },
    {
      "title": "Useful phrases",
      "explanation": "These come up constantly.",
