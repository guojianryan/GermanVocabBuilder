  "keyTrap": {
    "title": "The big trap: the second verb goes last",
    "explanation": "Können takes second place; the action verb goes to the end, unchanged.",
    "wrong": {
      "german": "Ich kann spreche Deutsch.",
      "verdict": "The second verb stays in the infinitive, at the end."
    },
