      "german": "also",
      "english": "so, therefore",
      "type": "adverb"
    }
  ],
  "keyTrap": {
    "title": "The big trap: me too or me neither?",
    "explanation": "If the first sentence is negative, you need auch nicht.",
    "wrong": {
      "german": "Ich trinke keinen Alkohol. – Ich auch.",
      "verdict": "Agreeing with a negative needs auch nicht."
    },
    "correct": [
      {
        "german": "Ich trinke keinen Alkohol. – Ich auch nicht.",
        "literal": "Me also not.",
        "note": "Me neither: ich auch nicht."
      },
      {
        "german": "Ich trinke gern Tee. – Ich auch.",
        "literal": "Me also.",
        "note": "Me too: ich auch."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Position",
      "explanation": "Auch goes right before the part it adds to, usually after the verb.",
      "wrong": "Auch ich spreche Englisch auch.",
      "correct": "Ich spreche auch Englisch."
    },
    {
      "title": "auch vs also",
      "explanation": "German also means 'so'.",
      "wrong": "Ich komme also.",
      "correct": "Ich komme auch."
    }
  ],
