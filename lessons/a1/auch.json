  "intro": {
    "title": "Me too!",
    "paragraphs": [
      "Auch is the German 'also' or 'too'. Ich auch! is 'Me too!'. Remember that German also means 'so', so when you mean 'also', reach for auch."
    ]
  },
  "wordFamily": [
    {
      "german": "ich auch",
