  "keyTrap": {
    "title": "The big trap: der can be feminine",
    "explanation": "Der is also the dative of die. After mit, bei, von or zu, a feminine noun takes der.",
    "wrong": {
      "german": "Ich fahre mit die Bahn.",
      "verdict": "Mit takes the dative: der."
    },
    "correct": [
      {
        "german": "Ich fahre mit der Bahn.",
        "literal": "I travel with the train.",
        "note": "Feminine dative: der."
      },
      {
        "german": "Ich sehe den Mann.",
        "literal": "I see the man.",
        "note": "Masculine accusative: den."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Compound nouns",
      "explanation": "A compound takes the gender of its last part.",
      "examples": [
        {
          "german": "das Haus + die Tür = die Haustür",
          "english": "front door",
          "highlight": "die"
        }
      ]
    },
    {
      "title": "Natural gender doesn't always win",
      "explanation": "Das Mädchen (girl) is neuter because of -chen.",
      "wrong": "die Mädchen (one girl)",
      "correct": "das Mädchen"
    }
  ],
