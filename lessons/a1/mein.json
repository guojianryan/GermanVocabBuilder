  "keyTrap": {
    "title": "The big trap: the ending follows the thing owned",
    "explanation": "The ending depends on the gender of the noun, not on who owns it.",
    "wrong": {
      "german": "Das ist mein Tasche.",
      "verdict": "Die Tasche → meine."
    },
    "correct": [
