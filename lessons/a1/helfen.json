  "keyTrap": {
    "title": "The big trap: dative, not accusative",
    "explanation": "The person you help is in the dative: mir, dir, ihm, ihr, Ihnen.",
    "wrong": {
      "german": "Kannst du mich helfen?",
      "verdict": "Helfen takes the dative: mir."
    },
    "correct": [
      {
        "german": "Kannst du mir helfen?",
        "literal": "Can you to-me help?",
        "note": "Dative: mir."
      },
      {
        "german": "Kann ich Ihnen helfen?",
        "literal": "Can I to-you help?",
        "note": "Formal: Ihnen."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Help with something",
      "explanation": "Helping with a task takes bei + dative.",
      "wrong": "Hilf mir mit den Hausaufgaben.",
      "correct": "Hilf mir bei den Hausaufgaben."
    },
    {
      "title": "The command",
