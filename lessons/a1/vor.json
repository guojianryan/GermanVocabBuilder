  "keyTrap": {
    "title": "The big trap: 'ago' goes first",
    "explanation": "English puts 'ago' after: two days ago. German puts vor first, with the dative: vor zwei Tagen.",
    "wrong": {
      "german": "Ich war zwei Tage vor in Berlin.",
      "verdict": "Vor comes first."
    },
    "correct": [
      {
        "german": "Ich war vor zwei Tagen in Berlin.",
        "literal": "I was before two days in Berlin.",
        "note": "Ago: vor + dative."
      },
      {
        "german": "Es ist zehn vor acht.",
        "literal": "It's ten before eight.",
        "note": "Clock: to."
      }
    ]
  },
