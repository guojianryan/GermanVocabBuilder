  "keyTrap": {
    "title": "The big trap: kein or nicht?",
    "explanation": "Use kein with a noun that would have ein or no article. Use nicht for verbs, adjectives and nouns with der/die/das.",
    "wrong": {
      "german": "Ich habe nicht Zeit.",
      "verdict": "Zeit is a noun without article: keine Zeit."
    },
    "correct": [
      {
        "german": "Ich habe keine Zeit.",
        "literal": "I have no time.",
        "note": "Noun: kein."
      },
      {
        "german": "Ich komme nicht.",
        "literal": "I come not.",
        "note": "Verb: nicht."
      },
      {
        "german": "Das ist nicht mein Auto.",
        "literal": "That is not my car.",
        "note": "With mein/der: nicht."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Endings",
      "explanation": "Kein follows ein.",
      "wrong": "Ich habe kein Hund.",
      "correct": "Ich habe keinen Hund."
    }
