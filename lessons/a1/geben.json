  "keyTrap": {
    "title": "The big trap: who gets what",
    "explanation": "The person who receives is in the dative, the thing given is in the accusative.",
    "wrong": {
      "german": "Ich gebe dich das Buch.",
      "verdict": "The receiver needs the dative: dir."
    },
    "correct": [
      {
        "german": "Ich gebe dir das Buch.",
        "literal": "I give to-you the book.",
        "note": "Receiver: dative. Thing: accusative."
      },
      {
        "german": "Gib mir bitte das Salz.",
        "literal": "Give me please the salt.",
        "note": "Command: gib."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "es gibt + accusative",
      "explanation": "What exists is in the accusative.",
      "wrong": "Es gibt ein Supermarkt.",
      "correct": "Es gibt einen Supermarkt."
    },
    {
      "title": "The command",
      "explanation": "For du: gib! (not gebe!).",
      "examples": [
        {
          "german": "Gib mir das!",
          "english": "Give me that!",
          "highlight": "Gib"
        }
      ]
    }
  ],
