  "keyTrap": {
    "title": "The big trap: im or ins?",
    "explanation": "Im is for being there. Ins is for going there.",
    "wrong": {
      "german": "Ich gehe heute im Kino.",
      "verdict": "Going there needs ins."
    },
    "correct": [
      {
        "german": "Ich gehe heute ins Kino.",
        "literal": "I go today into-the cinema.",
        "note": "Going: ins."
      },
      {
        "german": "Ich bin im Kino.",
        "literal": "I am in-the cinema.",
        "note": "Being there: im."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Countries with an article",
      "explanation": "Most countries take nach, but those with an article take in: in die Schweiz, in die USA.",
      "examples": [
        {
          "german": "Wir fahren in die Türkei.",
          "english": "We're going to Turkey.",
          "highlight": "in"
        }
      ]
    },
    {
      "title": "Months",
      "explanation": "Months take im, not am.",
      "wrong": "am Juli",
      "correct": "im Juli"
    }
  ],
  "sampleSentences": [
