  "keyTrap": {
    "title": "The big trap: soll vs muss",
    "explanation": "Muss = must (necessity). Soll = someone wants/expects it.",
    "wrong": {
      "german": "Der Arzt sagt, ich muss mehr trinken. (just reporting advice)",
      "verdict": "Possible, but soll fits better for passing on advice."
    },
