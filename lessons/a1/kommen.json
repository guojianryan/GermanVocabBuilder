  "keyTrap": {
    "title": "The big trap: where you're from",
    "explanation": "Your country or city takes aus, not von.",
    "wrong": {
      "german": "Ich komme von Japan.",
      "verdict": "Origin: aus."
    },
    "correct": [
      {
        "german": "Ich komme aus Japan.",
        "literal": "I come out of Japan.",
        "note": "Origin: aus."
      },
      {
        "german": "Ich komme gerade vom Arzt.",
        "literal": "I come just from-the doctor.",
        "note": "Coming back from somewhere: von."
      }
    ]
  },
  "commonMistakes": [
