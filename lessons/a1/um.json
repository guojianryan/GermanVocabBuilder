      "type": "separable verb"
    },
    {
      "german": "gegen",
      "english": "around (approx. time)",
      "type": "preposition"
    }
  ],
  "keyTrap": {
    "title": "The big trap: um, am or im?",
    "explanation": "Clock times: um. Days and dates: am. Months, seasons, years: im (or nothing for years).",
    "wrong": {
      "german": "Ich komme am 8 Uhr.",
      "verdict": "Clock time: um."
    },
    "correct": [
      {
        "german": "Ich komme um 8 Uhr.",
        "literal": "I come at 8 o'clock.",
        "note": "Clock: um."
      },
      {
        "german": "Ich komme am Montag.",
        "literal": "I come on-the Monday.",
        "note": "Day: am."
      },
      {
        "german": "Ich komme im Mai.",
        "literal": "I come in-the May.",
        "note": "Month: im."
      }
    ]
  },
  "commonMistakes": [
