  "keyTrap": {
    "title": "The big trap: I'm good / I'm well",
    "explanation": "When saying how you are, use Mir geht es gut. Ich bin gut means you're good at something, or a good person.",
    "wrong": {
      "german": "Wie geht's? – Ich bin gut.",
      "verdict": "This sounds like 'I am a good person'."
    },
    "correct": [
      {
        "german": "Wie geht's? – Mir geht es gut.",
        "literal": "To me goes it good.",
        "note": "How you are: mir geht es gut."
      },
      {
        "german": "Danke, gut!",
        "literal": "Thanks, good!",
        "note": "The short answer."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Greetings take endings",
      "explanation": "Guten Tag, guten Morgen, gute Nacht: the ending matches the noun.",
      "examples": [
        {
          "german": "Guten Morgen!",
          "english": "Good morning!",
          "highlight": "Guten"
        },
        {
          "german": "Gute Nacht!",
          "english": "Good night!",
          "highlight": "Gute"
        }
      ]
    },
    {
      "title": "Well = gut",
      "explanation": "German has no separate word for 'well'.",
      "wrong": "Du sprichst wohl Deutsch.",
      "correct": "Du sprichst gut Deutsch."
    }
  ],
