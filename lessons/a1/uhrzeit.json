  "intro": {
    "title": "Halb drei is half past two",
    "paragraphs": [
      "There are two ways to tell the time. The official way, used for trains and appointments, is the 24-hour clock: 14.30 Uhr is vierzehn Uhr dreißig. The everyday way uses vor, nach, Viertel and halb.",
      "The trap is halb. Germans count towards the next hour, so halb drei means 'half way to three': 2:30, not 3:30."
    ]
  },
  "commonMistakes": [
    {
      "title": "The halb trap",
      "explanation": "Halb + next hour.",
      "wrong": "halb drei = 3:30",
      "correct": "halb drei = 2:30"
    }
  ],
