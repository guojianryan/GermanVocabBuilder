  "keyTrap": {
    "title": "The big trap: 'there is' = es gibt",
    "explanation": "To say something exists somewhere, use es gibt + accusative.",
    "wrong": {
      "german": "Da ist ein Park in meiner Straße.",
      "verdict": "Possible, but the normal way is es gibt."
    },
    "correct": [
      {
        "german": "In meiner Straße gibt es einen Park.",
        "literal": "In my street gives it a park.",
        "note": "Es gibt + accusative: einen Park."
      },
      {
        "german": "Gibt es hier eine Apotheke?",
        "literal": "Gives it here a pharmacy?",
        "note": "Asking if something exists."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "It for der and die nouns",
      "explanation": "Es is only for das-nouns. Der-nouns are er, die-nouns are sie.",
      "wrong": "Der Kaffee? Es ist kalt.",
      "correct": "Der Kaffee? Er ist kalt."
    },
    {
      "title": "Weather",
      "explanation": "Weather always uses es.",
