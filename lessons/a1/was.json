  "keyTrap": {
    "title": "The big trap: was or wer?",
    "explanation": "Was = what (things). Wer = who (people). Wer looks like 'where', but it isn't!",
    "wrong": {
      "german": "Was ist das? (pointing at a person)",
      "verdict": "For people: Wer ist das?"
    },
    "correct": [
      {
        "german": "Wer ist das?",
        "literal": "Who is that?",
        "note": "People: wer."
      },
      {
        "german": "Was ist das?",
        "literal": "What is that?",
        "note": "Things: was."
      }
    ]
  },
  "commonMistakes": [
    {
