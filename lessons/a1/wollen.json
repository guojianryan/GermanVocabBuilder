  "keyTrap": {
    "title": "The big trap: ich will ≠ I will",
    "explanation": "Ich will = I want. For the future, use werden or just the present.",
    "wrong": {
      "german": "Ich will morgen anrufen. (meaning: I'll call tomorrow)",
      "verdict": "This means 'I want to call tomorrow'."
    },
    "correct": [
      {
        "german": "Ich rufe morgen an.",
        "literal": "I call tomorrow.",
        "note": "Future: present tense + time."
      },
      {
        "german": "Ich will Ärztin werden.",
        "literal": "I want doctor to become.",
        "note": "Want: wollen."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Too direct in shops",
      "explanation": "Use möchte.",
      "wrong": "Ich will ein Bier.",
      "correct": "Ich möchte ein Bier."
    }
  ],
