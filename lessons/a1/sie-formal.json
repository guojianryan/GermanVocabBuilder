  "keyTrap": {
    "title": "The big trap: when to say du",
    "explanation": "Start with Sie for adults you don't know. Switch to du when they offer it.",
    "wrong": {
      "german": "Kannst du mir helfen? (to a police officer)",
      "verdict": "Too familiar. Use Sie."
    },
    "correct": [
      {
        "german": "Können Sie mir helfen?",
        "literal": "Can you help me?",
        "note": "Formal."
      },
      {
        "german": "Wollen wir uns duzen?",
        "literal": "Shall we say du?",
        "note": "How people offer du."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Capital letter",
      "explanation": "Formal Sie and Ihnen are always capitalised.",
      "wrong": "Wie geht es ihnen?",
      "correct": "Wie geht es Ihnen?"
    },
    {
      "title": "Verb form",
      "explanation": "Sie takes the plural form, even for one person.",
      "wrong": "Sie ist Herr Klein?",
      "correct": "Sind Sie Herr Klein?"
    }
  ],
