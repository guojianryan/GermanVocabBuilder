    },
    "meaning": "until; by; up to; to (from … to)",
    "shortDefinition": "Marks an end point in time or space."
  },
  "intro": {
    "title": "Bis morgen!",
    "paragraphs": [
      "Bis marks where something stops: bis morgen (until tomorrow), bis Berlin (as far as Berlin), von neun bis fünf (from nine to five). It's also in every goodbye: bis bald, bis später, bis dann."
    ]
  },
  "wordFamily": [
    {
      "german": "bis bald / bis später / bis morgen",
      "english": "see you soon / later / tomorrow",
      "type": "phrases"
    },
    {
      "german": "von … bis …",
      "english": "from … to …",
      "type": "phrase"
    },
    {
      "german": "bis zu",
      "english": "up to, as far as",
      "type": "phrase"
    }
  ],
  "keyTrap": {
    "title": "The big trap: bis + article",
    "explanation": "Bis on its own can't take an article. Add zu when there's a der, die or das.",
    "wrong": {
      "german": "Ich fahre bis den Bahnhof.",
      "verdict": "With an article, use bis zum / bis zur."
    },
    "correct": [
      {
        "german": "Ich fahre bis zum Bahnhof.",
        "literal": "I drive until to-the station.",
        "note": "With an article: bis zum, bis zur."
      },
      {
        "german": "Ich fahre bis Hamburg.",
        "literal": "I drive until Hamburg.",
        "note": "Cities and times without an article: just bis."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "By a deadline",
      "explanation": "Bis also means 'by' for deadlines.",
      "examples": [
        {
          "german": "Bitte antworten Sie bis Freitag.",
          "english": "Please reply by Friday.",
          "highlight": "bis"
        }
      ]
    },
    {
      "title": "Opening hours",
      "explanation": "Von … bis … for time ranges.",
      "wrong": "von 9 zu 17 Uhr",
      "correct": "von 9 bis 17 Uhr"
    }
  ],
  "sampleSentences": [
