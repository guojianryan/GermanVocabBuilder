  "keyTrap": {
    "title": "The big trap: nicht dürfen vs nicht müssen",
    "explanation": "Nicht dürfen = must not (forbidden). Nicht müssen = don't have to (optional).",
    "wrong": {
      "german": "Du musst hier nicht rauchen.",
      "verdict": "This means smoking is optional, not forbidden."
    },
    "correct": [
      {
        "german": "Du darfst hier nicht rauchen.",
        "literal": "You may here not smoke.",
        "note": "Forbidden: nicht dürfen."
      },
      {
        "german": "Du musst nicht kommen.",
        "literal": "You must not come.",
        "note": "Optional: nicht müssen = don't have to."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Main verb at the end",
      "explanation": "The second verb goes to the end, in the infinitive.",
      "wrong": "Darf ich rauchen hier?",
      "correct": "Darf ich hier rauchen?"
    },
    {
      "title": "Polite offers",
      "explanation": "Darf ich …? is the polite way to offer or ask.",
      "examples": [
        {
          "german": "Was darf es sein?",
          "english": "What can I get you?",
          "highlight": "darf"
        }
      ]
    }
  ],
