  "keyTrap": {
    "title": "The big trap: schon or schön?",
    "explanation": "Schon (o) = already. Schön (ö) = beautiful.",
    "wrong": {
      "german": "Das ist schon. (meaning: that's nice)",
      "verdict": "You need the umlaut: schön."
    },
    "correct": [
      {
        "german": "Das ist schön.",
        "literal": "That is beautiful.",
        "note": "Schön with ö."
      },
      {
        "german": "Ich bin schon fertig.",
        "literal": "I am already finished.",
        "note": "Already: schon."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "The answer 'not yet'",
      "explanation": "Hast du schon …? – Nein, noch nicht.",
      "examples": [
        {
          "german": "Hast du schon gegessen? – Noch nicht.",
          "english": "Have you eaten yet? – Not yet.",
          "highlight": "schon"
        }
      ]
    },
    {
      "title": "Ever",
      "explanation": "Schon mal = ever, before.",
      "examples": [
        {
          "german": "Warst du schon mal in Wien?",
