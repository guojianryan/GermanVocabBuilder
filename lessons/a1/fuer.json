  "intro": {
    "title": "Für dich",
    "paragraphs": [
      "Für means 'for' and always takes the accusative: für dich, für meinen Bruder. It's mostly straightforward, with one big exception: for how long something has been going on, German uses seit, not für."
    ]
  },
  "wordFamily": [
    {
      "german": "seit",
      "english": "for, since (until now)",
      "type": "preposition"
    },
    {
      "german": "Danke für …",
      "english": "Thanks for …",
      "type": "phrase"
    },
    {
      "german": "sich interessieren für",
      "english": "to be interested in",
      "type": "phrase"
    }
  ],
  "keyTrap": {
    "title": "The big trap: für or seit?",
    "explanation": "Something that started in the past and is still going on takes seit + dative, not für.",
    "wrong": {
      "german": "Ich wohne hier für drei Jahre.",
      "verdict": "You still live here, so it's seit."
    },
    "correct": [
      {
        "german": "Ich wohne hier seit drei Jahren.",
        "literal": "I live here since three years.",
        "note": "Still true: seit."
      },
      {
        "german": "Ich fahre für eine Woche nach Paris.",
        "literal": "I go for a week to Paris.",
        "note": "A planned period: für."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Accusative",
      "explanation": "Für always takes the accusative.",
      "wrong": "für meinem Vater",
      "correct": "für meinen Vater"
    },
    {
      "title": "Thanks for",
      "explanation": "Danke für + accusative.",
      "examples": [
        {
          "german": "Danke für die Einladung!",
          "english": "Thanks for the invitation!",
          "highlight": "für"
        }
      ]
    }
  ],
