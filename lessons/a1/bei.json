  "keyTrap": {
    "title": "The big trap: bei or zu?",
    "explanation": "Bei is where you are. Zu is where you're going.",
    "wrong": {
      "german": "Ich gehe bei meiner Oma.",
      "verdict": "Going there needs zu."
    },
    "correct": [
      {
        "german": "Ich gehe zu meiner Oma.",
        "literal": "I go to my grandma.",
        "note": "Going: zu."
      },
      {
        "german": "Ich bin bei meiner Oma.",
        "literal": "I am at my grandma.",
        "note": "Being there: bei."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Your employer",
      "explanation": "You work bei a company, not in or an.",
      "wrong": "Ich arbeite in Siemens.",
      "correct": "Ich arbeite bei Siemens."
    },
    {
      "title": "Near a town",
      "explanation": "Bei also means near a place.",
      "examples": [
        {
          "german": "Potsdam liegt bei Berlin.",
          "english": "Potsdam is near Berlin.",
          "highlight": "bei"
        }
      ]
    }
  ],
