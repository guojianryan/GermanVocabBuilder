  "keyTrap": {
    "title": "The big trap: answering danke",
    "explanation": "When someone says danke, the usual reply is bitte, not danke again.",
    "wrong": {
      "german": "Danke! – Danke!",
      "verdict": "Thanking back sounds odd. Say bitte."
    },
    "correct": [
      {
        "german": "Danke! – Bitte!",
        "literal": "Thanks! – You're welcome!",
        "note": "The standard reply."
      },
      {
        "german": "Danke schön! – Bitte schön!",
        "literal": "Thank you very much! – You're very welcome!",
        "note": "Matching the politeness."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "Where bitte goes",
      "explanation": "Bitte can go at the start, after the verb, or at the end, separated by a comma.",
