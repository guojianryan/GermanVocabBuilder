  "keyTrap": {
    "title": "The big trap: als or wenn?",
    "explanation": "English uses 'when' for everything. German splits it.",
    "wrong": {
      "german": "Wenn ich ein Kind war, wohnte ich in Wien.",
      "verdict": "One period in the past: als."
    },
    "correct": [
      {
        "german": "Als ich ein Kind war, wohnte ich in Wien.",
        "literal": "When I was a child…",
        "note": "Once, past: als."
      },
      {
        "german": "Wenn ich Zeit habe, besuche ich dich.",
        "literal": "When I have time…",
        "note": "Present/future: wenn."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "than: als, not wie",
      "explanation": "Comparisons with -er take als. Wie is for 'as … as'.",
      "wrong": "Er ist größer wie ich.",
      "correct": "Er ist größer als ich."
    },
    {
      "title": "as a job: no article",
      "explanation": "Als + job takes no article.",
      "examples": [
        {
          "german": "Sie arbeitet als Ärztin.",
          "english": "She works as a doctor.",
          "highlight": "als"
        }
      ]
    }
