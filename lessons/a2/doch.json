  "keyTrap": {
    "title": "The big trap: ja after a negative question",
    "explanation": "After a question with nicht or kein, 'yes' is doch.",
    "wrong": {
      "german": "Hast du keinen Hunger? – Ja!",
      "verdict": "Confusing: does that mean 'yes, I'm not hungry'?"
    },
    "correct": [
      {
        "german": "Hast du keinen Hunger? – Doch!",
        "literal": "Aren't you hungry? – Yes I am!",
        "note": "Contradicting the negative: doch."
      }
    ]
  },
  "commonMistakes": [
    {
      "title": "doch as a softener",
      "explanation": "In requests it sounds friendly, not pushy.",
      "examples": [
        {
          "german": "Komm doch mit!",
          "english": "Why don't you come along!",
          "highlight": "doch"
        }
      ]
    },
    {
      "title": "doch = but, however",
      "explanation": "Like aber, but stronger.",
      "examples": [
        {
          "german": "Es war teuer, doch es hat sich gelohnt.",
          "english": "It was expensive, but it was worth it.",
          "highlight": "doch"
        }
      ]
    }
  ],
